{
    "manifest_version": 2,
    "name": "Unlight Revive Speed Control",
    "version": "4.0",
    "description": "Adjustable game speed (x1..x5) for UNLIGHT:Revive",
    "browser_specific_settings": {
        "gecko": {
            "id": "unlight-speed-control@local"
        }
    },
    "permissions": [
        "storage"
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_title": "Unlight Speed Control"
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.playunlight-dmm.com/*"
            ],
            "all_frames": true,
            "run_at": "document_start",
            "js": [
                "cs.js"
            ]
        }
    ]
}
